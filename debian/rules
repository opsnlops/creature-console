#!/usr/bin/make -f

# Allow SWIFT_BUILD_FLAGS to be overridden (e.g., CI adds --swift-sdk static-linux).
SWIFT_BUILD_FLAGS ?= -c release --product creature-cli --static-swift-stdlib
SWIFT_BUILD_FLAGS_MQTT ?= -c release --product creature-mqtt --static-swift-stdlib
SWIFT_BUILD_FLAGS_AGENT ?= -c release --product creature-agent --static-swift-stdlib
SWIFT_BUILD_FLAGS_WORLD ?= -c release --product creature-world --static-swift-stdlib
SWIFT_BUILD_FLAGS_COMMUNICATOR_GATEWAY ?= -c release --product creature-communicator-gateway --static-swift-stdlib
SWIFT_BUILD_FLAGS_HOUSE ?= -c release --product creature-house --static-swift-stdlib
export SWIFT_BUILD_FLAGS
export SWIFT_BUILD_FLAGS_MQTT
export SWIFT_BUILD_FLAGS_AGENT
export SWIFT_BUILD_FLAGS_WORLD
export SWIFT_BUILD_FLAGS_COMMUNICATOR_GATEWAY

%:
	dh $@

override_dh_auto_configure:
	# Ensure Swift toolchain is available; not declared as a Debian dependency.
	command -v swift >/dev/null || (echo "Swift toolchain not found in PATH" >&2; exit 1)

override_dh_auto_build:
	cd Common && swift build $(SWIFT_BUILD_FLAGS)
	cd Common && swift build $(SWIFT_BUILD_FLAGS_MQTT)
	cd Common && swift build $(SWIFT_BUILD_FLAGS_AGENT)
	cd Common && swift build $(SWIFT_BUILD_FLAGS_WORLD)
	cd Common && swift build $(SWIFT_BUILD_FLAGS_COMMUNICATOR_GATEWAY)
	cd Common && swift build $(SWIFT_BUILD_FLAGS_HOUSE)

override_dh_auto_install:
	install -d $(CURDIR)/debian/creature-cli/usr/bin
	BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS) --show-bin-path)/creature-cli; \
		install -m755 $$BIN_PATH $(CURDIR)/debian/creature-cli/usr/bin/creature-cli
	BIN=$(CURDIR)/debian/creature-cli/usr/bin/creature-cli; \
	install -d $(CURDIR)/debian/creature-cli/usr/share/bash-completion/completions; \
	$$BIN --generate-completion-script bash > $(CURDIR)/debian/creature-cli/usr/share/bash-completion/completions/creature-cli; \
	install -d $(CURDIR)/debian/creature-cli/usr/share/zsh/vendor-completions; \
	$$BIN --generate-completion-script zsh > $(CURDIR)/debian/creature-cli/usr/share/zsh/vendor-completions/_creature-cli; \
	install -d $(CURDIR)/debian/creature-cli/usr/share/fish/vendor_completions.d; \
	$$BIN --generate-completion-script fish > $(CURDIR)/debian/creature-cli/usr/share/fish/vendor_completions.d/creature-cli.fish

	# Shared config for the relay units (conffile — compat 13 marks /etc automatically).
	install -d $(CURDIR)/debian/creature-cli/etc/default
	install -m644 $(CURDIR)/debian/creature-relay.default $(CURDIR)/debian/creature-cli/etc/default/creature-relay

	install -d $(CURDIR)/debian/creature-mqtt/usr/bin
	MQTT_BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS_MQTT) --show-bin-path)/creature-mqtt; \
		install -m755 $$MQTT_BIN_PATH $(CURDIR)/debian/creature-mqtt/usr/bin/creature-mqtt
	MQTT_BIN=$(CURDIR)/debian/creature-mqtt/usr/bin/creature-mqtt; \
	install -d $(CURDIR)/debian/creature-mqtt/usr/share/bash-completion/completions; \
	$$MQTT_BIN --generate-completion-script bash > $(CURDIR)/debian/creature-mqtt/usr/share/bash-completion/completions/creature-mqtt; \
	install -d $(CURDIR)/debian/creature-mqtt/usr/share/zsh/vendor-completions; \
	$$MQTT_BIN --generate-completion-script zsh > $(CURDIR)/debian/creature-mqtt/usr/share/zsh/vendor-completions/_creature-mqtt; \
	install -d $(CURDIR)/debian/creature-mqtt/usr/share/fish/vendor_completions.d; \
	$$MQTT_BIN --generate-completion-script fish > $(CURDIR)/debian/creature-mqtt/usr/share/fish/vendor_completions.d/creature-mqtt.fish

	install -d $(CURDIR)/debian/creature-agent/etc/default
	install -m644 $(CURDIR)/debian/creature-agent.default $(CURDIR)/debian/creature-agent/etc/default/creature-agent
	# Agent configuration lives beside the World's in /etc/creature: agent.yaml for the single
	# unit, agent/<instance>.yaml for creature-agent@<instance>.
	install -d $(CURDIR)/debian/creature-agent/etc/creature/agent
	install -m644 $(CURDIR)/debian/creature-agent.yaml $(CURDIR)/debian/creature-agent/etc/creature/agent.yaml
	# Personas are April's content, versioned in docs/personas and installed as conffiles so an
	# edited bird is never overwritten by an upgrade.
	install -d $(CURDIR)/debian/creature-agent/etc/creature/agent/personas
	install -m644 $(CURDIR)/docs/personas/*.yaml $(CURDIR)/debian/creature-agent/etc/creature/agent/personas/
	install -d $(CURDIR)/debian/creature-agent/usr/bin
	AGENT_BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS_AGENT) --show-bin-path)/creature-agent; \
		install -m755 $$AGENT_BIN_PATH $(CURDIR)/debian/creature-agent/usr/bin/creature-agent
	AGENT_BIN=$(CURDIR)/debian/creature-agent/usr/bin/creature-agent; \
	install -d $(CURDIR)/debian/creature-agent/usr/share/bash-completion/completions; \
	$$AGENT_BIN --generate-completion-script bash > $(CURDIR)/debian/creature-agent/usr/share/bash-completion/completions/creature-agent; \
	install -d $(CURDIR)/debian/creature-agent/usr/share/zsh/vendor-completions; \
	$$AGENT_BIN --generate-completion-script zsh > $(CURDIR)/debian/creature-agent/usr/share/zsh/vendor-completions/_creature-agent; \
	install -d $(CURDIR)/debian/creature-agent/usr/share/fish/vendor_completions.d; \
	$$AGENT_BIN --generate-completion-script fish > $(CURDIR)/debian/creature-agent/usr/share/fish/vendor_completions.d/creature-agent.fish

	# Creature World follows the repository's merged-/usr convention. /bin is the
	# canonical package and service path even though Debian resolves it through /usr.
	install -d $(CURDIR)/debian/creature-world/bin
	WORLD_BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS_WORLD) --show-bin-path)/creature-world; \
		install -m755 $$WORLD_BIN_PATH $(CURDIR)/debian/creature-world/bin/creature-world
	WORLD_BIN=$(CURDIR)/debian/creature-world/bin/creature-world; \
	install -d $(CURDIR)/debian/creature-world/usr/share/bash-completion/completions; \
	$$WORLD_BIN --generate-completion-script bash > $(CURDIR)/debian/creature-world/usr/share/bash-completion/completions/creature-world; \
	install -d $(CURDIR)/debian/creature-world/usr/share/zsh/vendor-completions; \
	$$WORLD_BIN --generate-completion-script zsh > $(CURDIR)/debian/creature-world/usr/share/zsh/vendor-completions/_creature-world; \
	install -d $(CURDIR)/debian/creature-world/usr/share/fish/vendor_completions.d; \
	$$WORLD_BIN --generate-completion-script fish > $(CURDIR)/debian/creature-world/usr/share/fish/vendor_completions.d/creature-world.fish
	install -d $(CURDIR)/debian/creature-world/etc/creature
	install -m644 $(CURDIR)/debian/creature-world.json $(CURDIR)/debian/creature-world/etc/creature/world.json
	install -d $(CURDIR)/debian/creature-world/etc/default
	install -m644 $(CURDIR)/debian/creature-world.default $(CURDIR)/debian/creature-world/etc/default/creature-world

	# The Communicator Gateway is an independently versioned and deployed service.
	install -d $(CURDIR)/debian/creature-communicator-gateway/bin
	GATEWAY_BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS_COMMUNICATOR_GATEWAY) --show-bin-path)/creature-communicator-gateway; \
		install -m755 $$GATEWAY_BIN_PATH $(CURDIR)/debian/creature-communicator-gateway/bin/creature-communicator-gateway
	GATEWAY_BIN=$(CURDIR)/debian/creature-communicator-gateway/bin/creature-communicator-gateway; \
	install -d $(CURDIR)/debian/creature-communicator-gateway/usr/share/bash-completion/completions; \
	$$GATEWAY_BIN --generate-completion-script bash > $(CURDIR)/debian/creature-communicator-gateway/usr/share/bash-completion/completions/creature-communicator-gateway; \
	install -d $(CURDIR)/debian/creature-communicator-gateway/usr/share/zsh/vendor-completions; \
	$$GATEWAY_BIN --generate-completion-script zsh > $(CURDIR)/debian/creature-communicator-gateway/usr/share/zsh/vendor-completions/_creature-communicator-gateway; \
	install -d $(CURDIR)/debian/creature-communicator-gateway/usr/share/fish/vendor_completions.d; \
	$$GATEWAY_BIN --generate-completion-script fish > $(CURDIR)/debian/creature-communicator-gateway/usr/share/fish/vendor_completions.d/creature-communicator-gateway.fish
	install -d $(CURDIR)/debian/creature-communicator-gateway/etc/creature
	install -m644 $(CURDIR)/debian/creature-communicator-gateway.json $(CURDIR)/debian/creature-communicator-gateway/etc/creature/communicator-gateway.json
	install -d $(CURDIR)/debian/creature-communicator-gateway/etc/default
	install -m644 $(CURDIR)/debian/creature-communicator-gateway.default $(CURDIR)/debian/creature-communicator-gateway/etc/default/creature-communicator-gateway

	# The house: Home Assistant into the world, and the lights back out. Independently versioned.
	install -d $(CURDIR)/debian/creature-house/bin
	HOUSE_BIN_PATH=$$(cd Common && swift build $(SWIFT_BUILD_FLAGS_HOUSE) --show-bin-path)/creature-house; \
		install -m755 $$HOUSE_BIN_PATH $(CURDIR)/debian/creature-house/bin/creature-house
	install -d $(CURDIR)/debian/creature-house/etc/creature
	install -m644 $(CURDIR)/debian/creature-house.json $(CURDIR)/debian/creature-house/etc/creature/house.json
	install -d $(CURDIR)/debian/creature-house/etc/default
	install -m600 $(CURDIR)/debian/creature-house.default $(CURDIR)/debian/creature-house/etc/default/creature-house

# The relay units ship disabled: they only make sense on the host that bridges the
# animatronic VLAN (April enables them there by hand). The agent/mqtt services keep the
# debhelper default (enabled on install).
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start -pcreature-cli --name=creature-sacn-relay
	dh_installsystemd --no-enable --no-start -pcreature-cli --name=creature-audio-relay
	dh_installsystemd -pcreature-agent
	dh_installsystemd -pcreature-mqtt
	# Installation must not start a server before the administrator has reviewed
	# its bind address and telemetry settings.
	dh_installsystemd --no-start -pcreature-world
	dh_installsystemd --no-start -pcreature-communicator-gateway
	dh_installsystemd --no-start -pcreature-house

# The Debian source package retains the established creature-cli version, while
# Creature World is independently versioned by its own executable metadata.
override_dh_gencontrol:
	dh_gencontrol -pcreature-cli
	dh_gencontrol -pcreature-mqtt
	dh_gencontrol -pcreature-agent
	WORLD_VERSION=$$($(CURDIR)/debian/creature-world/bin/creature-world --version); \
		dh_gencontrol -pcreature-world -- -v$$WORLD_VERSION
	GATEWAY_VERSION=$$($(CURDIR)/debian/creature-communicator-gateway/bin/creature-communicator-gateway --version); \
		dh_gencontrol -pcreature-communicator-gateway -- -v$$GATEWAY_VERSION
	HOUSE_VERSION=$$($(CURDIR)/debian/creature-house/bin/creature-house --version); \
		dh_gencontrol -pcreature-house -- -v$$HOUSE_VERSION

override_dh_dwz:
	# Skip dwz; binary may lack supported debug sections (static Swift).
	:
