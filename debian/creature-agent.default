# Creature Agent environment. This file is a conffile: package upgrades preserve local edits.
#
# Creature Server, passed to the unit's --host/--port. MQTT mode speaks through it; world mode
# (mode: world in /etc/creature/agent.yaml) does not use it yet but the unit still needs values.
CREATURE_SERVER_HOST=server.prod.chirpchirp.dev
CREATURE_SERVER_PORT=443

# OpenTelemetry (uncomment to enable OTLP export; without these, console-only logging is used)
#OTEL_SERVICE_NAME=creature-agent
#OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
#OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY_HERE
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
