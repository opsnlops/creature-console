{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creature.engineering/schemas/world-definitions-v1.schema.json",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "eventID": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "namespacedID": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9._:-]+$"
    },
    "factID": {
      "type": "string",
      "pattern": "^fact:[a-z0-9._:-]+$"
    },
    "considerationID": {
      "type": "string",
      "pattern": "^consideration:[a-z0-9._:-]+$"
    },
    "interactionID": {
      "type": "string",
      "pattern": "^interaction:[a-z0-9._:-]+$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "epistemic": {
      "type": "object",
      "required": ["type", "confidence"],
      "properties": {
        "type": {
          "enum": [
            "observed",
            "reported",
            "scheduled",
            "forecast",
            "inferred",
            "assumed",
            "remembered"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": ["traceparent"],
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}-[0-9A-Fa-f]{32}-[0-9A-Fa-f]{16}-[0-9A-Fa-f]{2}$"
        },
        "tracestate": {
          "type": ["string", "null"]
        },
        "baggage": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    }
  }
}
