FROM debian:trixie-slim

SHELL ["/bin/bash", "-lc"]

# Keep in step with SWIFT_VERSION in .github/workflows/build-deb.yml.
ARG SWIFT_VERSION=6.3.3

ENV DEBIAN_FRONTEND=noninteractive \
    SWIFT_VERSION=${SWIFT_VERSION} \
    SWIFT_PREFIX=/opt/swift

# Dependencies mirror the CI deb build job.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl ca-certificates pkg-config clang \
        libicu-dev libxml2-dev libbsd-dev libcurl4-openssl-dev \
        libssl-dev libsqlite3-dev libzstd-dev libedit-dev zlib1g-dev \
        git cmake ninja-build python3 tar xz-utils build-essential \
        debhelper devscripts fakeroot rsync; \
    rm -rf /var/lib/apt/lists/*

# Install the Debian Swift toolchain directly from the swift.org release tarball. This is the
# same toolchain Swiftly selects on Debian; swift.org publishes "debian12" builds (there is no
# separate trixie build yet) and names x86_64 tarballs without an architecture suffix
# ("swift-6.3.3-RELEASE-debian12.tar.gz") and aarch64 tarballs with one
# ("debian12-aarch64", "swift-6.3.3-RELEASE-debian12-aarch64.tar.gz").
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
      x86_64) ARCH_SUFFIX="" ;; \
      aarch64|arm64) ARCH_SUFFIX="-aarch64" ;; \
      *) echo "Unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    OS_TAG="debian12"; \
    PATH_SEG="${OS_TAG}${ARCH_SUFFIX}"; \
    TARBALL="swift-${SWIFT_VERSION}-RELEASE-${OS_TAG}${ARCH_SUFFIX}.tar.gz"; \
    URL="https://download.swift.org/swift-${SWIFT_VERSION}-release/${PATH_SEG}/swift-${SWIFT_VERSION}-RELEASE/${TARBALL}"; \
    curl -fL "$URL" -o "$TARBALL"; \
    mkdir -p "${SWIFT_PREFIX}"; \
    tar xzf "$TARBALL" --strip-components=1 -C "${SWIFT_PREFIX}"; \
    rm "$TARBALL"

ENV PATH="${SWIFT_PREFIX}/usr/bin:${PATH}"

WORKDIR /workspace

CMD ["/bin/bash"]
